{
    "name": "FocusDefaultTheme",
    "type": "theme",
    "front": {
        "priority": 0,
        "watch": {
            "views": [
                "Themes/FocusDefaultTheme/resources/views/**/*.blade.php"
            ]
        },
        "build": {
            "js": [
                "Themes/FocusDefaultTheme/resources/js/theme.js"
            ],
            "css": [
                "Themes/FocusDefaultTheme/resources/css/theme.css"
            ]
        },
        "plugins": {
            "npm": [
                "@tailwindcss/vite@4.3.3",
                "laravel-vite-plugin@^3.2.0",
                "vite@^8.2.2",
                "daisyui@5.7.22",
                "alpinejs@3.16.3",
                "jquery@4.0.0",
                "js-cookie@3.0.5",
                "photoswipe@5.4.4",
                "iconify-icon@3.0.0",
                "@iconify/tailwind4@^1.2.3",
                "@iconify/json@^2.2.0",
                "@uppy/core@6.0.0",
                "@uppy/dashboard@6.0.0",
                "@uppy/xhr-upload@5.2.0"
            ],
            "vite": [
                {
                    "package": "@tailwindcss/vite",
                    "import": "tailwindcss",
                    "call": true
                },
                {
                    "package": "laravel-vite-plugin",
                    "import": "laravel",
                    "call": true
                }
            ]
        }
    },
    "orchestration": {
        "npm": [
            "concurrently@^9.0.0"
        ]
    }
}